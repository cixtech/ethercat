ccflags-y := -I$(src)/..

REV := $(shell if test -s $(src)/../revision; then cat $(src)/../revision; else echo 1.6.8; fi)

EC_GENERIC_OBJ := generic.o
obj-m += ec_generic.o
ec_generic-objs := $(EC_GENERIC_OBJ)
CFLAGS_$(EC_GENERIC_OBJ) = -DREV=$(REV)

obj-m += macb/

KBUILD_EXTRA_SYMBOLS := $(src)/../master/Module.symvers

